# refero-mcp — environment variable template
#
# Everything here is optional. The MCP runs with no env at all; these knobs
# are for vibe search, custom cache locations, and pointing save_to_project
# at your own vault.
#
# Copy this file to `.env` (gitignored) and fill in only what you need.

# Optional: enables vibe search via OpenAI's text-embedding-3-small.
# Without this, search falls back to keyword scoring on northStar + tags + siteName.
OPENAI_API_KEY=

# Optional: override the Refero API base URL.
# Default: https://styles.refero.design
# Useful if Refero ever moves the API or you're pointing at a fixture in tests.
REFERO_API_BASE=

# Optional: where the local catalog mirror, embeddings, and detail cache live.
# Default: ~/.refero-cache
REFERO_CACHE_DIR=

# Optional: how long before a cached page is considered stale (milliseconds).
# Default: 86400000 (24 hours)
REFERO_CACHE_TTL_MS=

# Required for `save_to_project`: absolute path to the vault / workspace root.
# If unset, `refero_design_md` returns the markdown but refuses to write to disk.
# Resolved write path: <REFERO_MCP_VAULT_DIR>/05-Projects/<NAME>/DESIGN.md
REFERO_MCP_VAULT_DIR=
